# Gmail search query
gmail_query=newer_than:365d

# Google OAuth client secret JSON path (for local sync CLI)
google_client_secret_path=secrets/client_secret.json

# OAuth token path (for local sync CLI)
google_token_path=secrets/token.json

# Google Calendar ID for YogiSync
yogisync_calendar_id=YOUR_CALENDAR_ID

# Optional: override timezone
timezone=Asia/Tokyo

# Default duration for timed events (minutes)
default_event_duration_minutes=60

# SQLite DB path
sqlite_path=data/yogisync.db

# Optional: local service account JSON path for Streamlit dashboard
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/service_account.json

# Yoga classifier
YOGA_CLASSIFIER_ENABLED=true
YOGA_CLASSIFIER_TARGET_PROVIDERS=peatix
OPENAI_MODEL_YOGA_CLASSIFIER=gpt-5-mini

# AI metadata enricher
# 注意: YOGA_CLASSIFIER_ENABLED=true のときのみ動作
AI_ENRICHER_ENABLED=true
# 安全側: 空だと無効（対象なし）
AI_ENRICHER_TARGET_PROVIDERS=peatix,yes_tokyo,life_tuning
AI_ENRICHER_MAX_CHARS_MAIL=1200
AI_ENRICHER_MAX_CHARS_SOURCE=2500
AI_ENRICHER_HTTP_TIMEOUT_SEC=10
AI_ENRICHER_MODEL=gpt-5-mini
AI_ENRICHER_FAIL_OPEN=true
AI_ENRICHER_CACHE_TTL_HOURS=24
